<Page
    x:Class="Cemu_UWP_Host.DirectXPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cemu_UWP_Host"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    Background="#FF051A13">

  <Page.Resources>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF051A13" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#FF0A2A20" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F20A241B" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF10382B" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF1689E8" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#FF42A5F5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFBED8CE" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2C6251" />

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="HelpfulTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LibraryItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MinHeight" Value="54" />
    </Style>
  </Page.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            MinHeight="64"
            Background="{StaticResource TopBarBrush}">
      <!-- Keep the Xbox bar on one compact row. Controller and account details
           remain available to code, but only their icons consume bar space. -->
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
          <Button x:Name="toggleTabsButton"
                  Height="44"
                  Padding="12,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Click="ToggleTabs_Click">
            <StackPanel Orientation="Horizontal">
              <FontIcon Glyph="&#xE8FD;"
                        FontSize="17"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
              <TextBlock x:Name="toggleTabsButtonText"
                         Text="Hide options"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="startButton"
                  Height="44"
                  Padding="14,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Click="StartGame_Click"
                  IsEnabled="False">
            <TextBlock Text="Start game"
                       VerticalAlignment="Center" />
          </Button>
          <Button x:Name="metricsButton"
                  Height="44"
                  Padding="12,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Click="ToggleMetrics_Click"
                  IsEnabled="False">
            <StackPanel Orientation="Horizontal">
              <FontIcon Glyph="&#xE9D2;"
                        FontSize="17"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
              <TextBlock x:Name="metricsButtonText"
                         Text="Show metrics"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Column="1"
                  Width="1"
                  Height="32"
                  Background="{StaticResource DividerBrush}"
                  Margin="18,0" />

        <Grid Grid.Column="2"
              VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="5"
                  Height="34"
                  Background="{StaticResource AccentBlueBrush}"
                  CornerRadius="3"
                  Margin="0,0,12,0" />
          <StackPanel Grid.Column="1"
                      VerticalAlignment="Center">
            <TextBlock Text="Status"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock x:Name="launchStatus"
                       Text="Initializing emulator..."
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="White" />
          </StackPanel>
        </Grid>

        <Border Grid.Column="3"
                Width="1"
                Height="32"
                Background="{StaticResource DividerBrush}"
                Margin="18,0" />

        <Grid Grid.Column="4"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              ToolTipService.ToolTip="Controller status">
          <FontIcon x:Name="controllerStatusIcon"
                    Glyph="&#xE7FC;"
                    FontSize="19"
                    Foreground="{StaticResource AccentBlueBrush}" />
          <TextBlock x:Name="controllerStatus"
                     Text="Controller disconnected"
                     Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Column="5"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              ToolTipService.ToolTip="Account status">
          <FontIcon x:Name="accountStatusIcon"
                    Glyph="&#xE77B;"
                    FontSize="19"
                    Foreground="{StaticResource AccentBlueBrush}" />
          <TextBlock x:Name="accountStatus"
                     Text="Account: loading..."
                     Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Border>

    <!-- The emulator always fills the space below the command bar. The tools
         are drawn over it and do not resize the SwapChainPanel. -->
    <Grid x:Name="emulatorViewport"
          Grid.Row="1"
          Background="#FF020B08"
          PointerPressed="EmulatorViewport_PointerPressed"
          SizeChanged="EmulatorViewport_SizeChanged">
      <SwapChainPanel x:Name="emulatorSurface"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      CompositionScaleChanged="EmulatorSurface_CompositionScaleChanged" />

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <TextBlock x:Name="emulatorPlaceholder"
                   Text="The game will appear here"
                   FontSize="16"
                   Foreground="#8ABED8CE" />
      </StackPanel>

      <!-- Optional in-game Wii U GamePad pointer. This is not used for XAML
           navigation; L+R toggles it only after a title has started. -->
      <StackPanel x:Name="virtualMouseCursor"
                  Canvas.ZIndex="30"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  Background="#CC0A2A20"
                  Padding="3"
                  Opacity="0.95"
                  Visibility="Collapsed">
        <StackPanel.RenderTransform>
          <TranslateTransform x:Name="virtualMouseTransform" />
        </StackPanel.RenderTransform>
        <FontIcon Glyph="&#xE7C9;"
                  FontSize="28"
                  Foreground="White" />
      </StackPanel>

      <StackPanel x:Name="tabsPanel"
                  Canvas.ZIndex="10"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  MaxHeight="420"
                  Background="{StaticResource PanelBrush}">
        <Pivot x:Name="toolTabs"
               Background="Transparent"
               Foreground="White">
          <PivotItem Header="My games">
            <Grid Padding="24,6,24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="16,12"
                      Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="36"
                          Height="36"
                          Background="#332A9DF4"
                          CornerRadius="18"
                          VerticalAlignment="Top"
                          Margin="0,0,12,0">
                    <FontIcon Glyph="&#xE946;"
                              FontSize="18"
                              Foreground="{StaticResource AccentBlueBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Getting started"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="1. Install content  •  2. Choose a game and press A  •  3. Select Start game"
                               Style="{StaticResource HelpfulTextStyle}"
                               Margin="0,3,0,0" />
                    <TextBlock Text="Extracted folders must contain code, content, and meta. Updates and DLC are linked automatically."
                               Style="{StaticResource HelpfulTextStyle}"
                               FontSize="13"
                               Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Installed games"
                             Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="The confirmed game remains selected while you navigate the screen."
                             Style="{StaticResource HelpfulTextStyle}"
                             Margin="0,2,12,0" />
                </StackPanel>

                <CommandBar Grid.Column="1"
                            Background="Transparent"
                            Foreground="White"
                            DefaultLabelPosition="Bottom"
                            IsDynamicOverflowEnabled="True">
                  <AppBarButton x:Name="installContentButton"
                                Label="Install content"
                                Icon="Add"
                                Foreground="White"
                                IsEnabled="False"
                                Click="InstallContent_Click" />
                  <AppBarButton x:Name="refreshLibraryButton"
                                Label="Refresh list"
                                Icon="Refresh"
                                Foreground="White"
                                IsEnabled="False"
                                Click="RefreshLibrary_Click" />
                  <AppBarButton x:Name="installGraphicPacksButton"
                                Label="Import enhancements"
                                Icon="Manage"
                                Foreground="White"
                                IsEnabled="False"
                                Click="InstallGraphicPacks_Click" />
                </CommandBar>
              </Grid>

              <Border Grid.Row="2"
                      Background="#CC071E17"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="5">
                <ListView x:Name="installedGamesList"
                          Background="Transparent"
                          Foreground="White"
                          ItemContainerStyle="{StaticResource LibraryItemStyle}"
                          SelectionChanged="InstalledGames_SelectionChanged"
                          ItemClick="InstalledGames_ItemClick"
                          IsItemClickEnabled="True"
                          SelectionMode="Single"
                          SingleSelectionFollowsFocus="False"
                          MinHeight="105"
                          MaxHeight="165">
                  <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF0D6ECA" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF1689E8" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#55366B58" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                  </ListView.Resources>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 Foreground="White"
                                 Margin="2" />
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </Grid>
          </PivotItem>

          <PivotItem Header="Help and errors">
            <Grid Padding="24,6,24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Session diagnostics"
                             Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="If something does not work, check the latest message below. The complete log is stored in the app's local data."
                             Style="{StaticResource HelpfulTextStyle}"
                             Margin="0,3,16,0" />
                </StackPanel>
                <AppBarButton Grid.Column="1"
                              Label="Clear messages"
                              Icon="Delete"
                              Foreground="White"
                              Click="ClearErrors_Click"
                              HorizontalAlignment="Right" />
              </Grid>

              <Border Grid.Row="1"
                      Background="#CC071E17"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="8">
                <ListView x:Name="errorsList"
                          Background="Transparent"
                          Margin="0"
                          MinHeight="115"
                          MaxHeight="230">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFE57373"
                                CornerRadius="2"
                                Margin="0,1,10,1" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   Foreground="#FFFFC7C7" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </Grid>
          </PivotItem>
        </Pivot>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
