<Page
    x:Class="Cemu_UWP_Host.DirectXPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cemu_UWP_Host"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    Background="#FF051A13">

  <Page.Resources>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FF051A13" />
    <SolidColorBrush x:Key="TopBarBrush" Color="#FF0A2A20" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F20A241B" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF10382B" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF1689E8" />
    <SolidColorBrush x:Key="AccentBlueHoverBrush" Color="#FF42A5F5" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFBED8CE" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2C6251" />

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="HelpfulTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="LibraryItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MinHeight" Value="54" />
    </Style>
  </Page.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="topCommandBar"
            Grid.Row="0"
            MinHeight="64"
            Background="{StaticResource TopBarBrush}">
      <!-- Keep the Xbox bar on one compact row. Controller and account details
           remain available to code, but only their icons consume bar space. -->
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
          <Button x:Name="toggleTabsButton"
                  Height="44"
                  Padding="12,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Click="ToggleTabs_Click">
            <StackPanel Orientation="Horizontal">
              <FontIcon Glyph="&#xE8FD;"
                        FontSize="17"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
              <TextBlock x:Name="toggleTabsButtonText"
                         Text="Hide options"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="startButton"
                  Height="44"
                  Padding="14,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Click="StartGame_Click"
                  IsEnabled="False">
            <TextBlock Text="Start game"
                       VerticalAlignment="Center" />
          </Button>
          <Button x:Name="metricsButton"
                  Height="44"
                  Padding="12,0"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  Click="ToggleMetrics_Click"
                  IsEnabled="False">
            <StackPanel Orientation="Horizontal">
              <FontIcon Glyph="&#xE9D2;"
                        FontSize="17"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
              <TextBlock x:Name="metricsButtonText"
                         Text="Show metrics"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Column="1"
                  Width="1"
                  Height="32"
                  Background="{StaticResource DividerBrush}"
                  Margin="18,0" />

        <Grid Grid.Column="2"
              VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Width="5"
                  Height="34"
                  Background="{StaticResource AccentBlueBrush}"
                  CornerRadius="3"
                  Margin="0,0,12,0" />
          <StackPanel Grid.Column="1"
                      VerticalAlignment="Center">
            <TextBlock Text="Status"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock x:Name="launchStatus"
                       Text="Initializing emulator..."
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="White" />
          </StackPanel>
        </Grid>

        <Border Grid.Column="3"
                Width="1"
                Height="32"
                Background="{StaticResource DividerBrush}"
                Margin="18,0" />

        <Grid Grid.Column="4"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              ToolTipService.ToolTip="Controller status">
          <FontIcon x:Name="controllerStatusIcon"
                    Glyph="&#xE7FC;"
                    FontSize="19"
                    Foreground="{StaticResource AccentBlueBrush}" />
          <TextBlock x:Name="controllerStatus"
                     Text="Controller disconnected"
                     Visibility="Collapsed" />
        </Grid>

        <Grid Grid.Column="5"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              ToolTipService.ToolTip="Account status">
          <FontIcon x:Name="accountStatusIcon"
                    Glyph="&#xE77B;"
                    FontSize="19"
                    Foreground="{StaticResource AccentBlueBrush}" />
          <TextBlock x:Name="accountStatus"
                     Text="Account: loading..."
                     Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Border>

    <!-- The emulator always fills the space below the command bar. The tools
         are drawn over it and do not resize the SwapChainPanel. -->
    <Grid x:Name="emulatorViewport"
          Grid.Row="1"
          Background="#FF020B08"
          PointerPressed="EmulatorViewport_PointerPressed"
          SizeChanged="EmulatorViewport_SizeChanged">
      <SwapChainPanel x:Name="emulatorSurface"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      CompositionScaleChanged="EmulatorSurface_CompositionScaleChanged" />

      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False">
        <TextBlock x:Name="emulatorPlaceholder"
                   Text="The game will appear here"
                   FontSize="16"
                   Foreground="#8ABED8CE" />
      </StackPanel>

      <!-- Shown only while a brokered external title is being staged. Keeping
           it above the SwapChainPanel prevents the blank presentation surface
           from looking like a frozen or failed launch. -->
      <Grid x:Name="externalLoadingOverlay"
            Canvas.ZIndex="25"
            Background="#E60A241B"
            Visibility="Collapsed"
            IsHitTestVisible="True">
        <Border Width="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F212382C"
                BorderBrush="#FF3B7A66"
                BorderThickness="1"
                CornerRadius="10"
                Padding="32,28">
          <StackPanel HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Center"
                  Width="72"
                  Height="72"
                  Margin="0,0,0,18">
              <ProgressRing x:Name="externalLoadingRing"
                            Width="72"
                            Height="72"
                            IsActive="False"
                            Foreground="{StaticResource AccentBlueBrush}" />
              <FontIcon Glyph="&#xE768;"
                        FontSize="25"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="externalLoadingTitle"
                       Text="Loading external game"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center" />
            <TextBlock x:Name="externalLoadingDetail"
                       Text="Preparing external storage..."
                       FontSize="14"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,16" />
            <ProgressBar x:Name="externalLoadingProgress"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="10"
                         Foreground="{StaticResource AccentBlueBrush}"
                         Background="#FF082018" />
            <TextBlock x:Name="externalLoadingPercent"
                       Text="0%"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Optional in-game Wii U GamePad pointer. This is not used for XAML
           navigation; L+R toggles it only after a title has started. -->
      <!-- Keep the pointer hotspot at the upper-left corner. A Path is used
           instead of the combined touch-pointer glyph so only the arrow is
           shown over the game. -->
      <Path x:Name="virtualMouseCursor"
            Canvas.ZIndex="30"
            Width="22"
            Height="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Data="M 1,1 L 1,25 L 7.5,18.5 L 12.5,29 L 17,27 L 12,17 L 21,17 Z"
            Fill="White"
            Stroke="#FF07130F"
            StrokeThickness="1.5"
            Stretch="Fill"
            Visibility="Collapsed">
        <Path.RenderTransform>
          <TranslateTransform x:Name="virtualMouseTransform" />
        </Path.RenderTransform>
      </Path>

      <Grid x:Name="tabsPanel"
            Canvas.ZIndex="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            MaxHeight="420"
            Background="{StaticResource PanelBrush}">
        <Pivot x:Name="toolTabs"
               Background="Transparent"
               Foreground="White"
               SelectionChanged="ToolTabs_SelectionChanged">
          <PivotItem Header="My games">
            <Grid Padding="24,6,24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="16,12"
                      Margin="0,0,0,10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="36"
                          Height="36"
                          Background="#332A9DF4"
                          CornerRadius="18"
                          VerticalAlignment="Top"
                          Margin="0,0,12,0">
                    <FontIcon Glyph="&#xE946;"
                              FontSize="18"
                              Foreground="{StaticResource AccentBlueBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1"
                              VerticalAlignment="Center">
                    <TextBlock Text="Getting started"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="A quick guide for installing and starting games"
                               Style="{StaticResource HelpfulTextStyle}"
                               FontSize="13"
                               Margin="0,2,8,0" />
                  </StackPanel>
                  <Button x:Name="gettingStartedToggleButton"
                          Grid.Column="2"
                          MinWidth="116"
                          Padding="10,6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Foreground="White"
                          BorderBrush="{StaticResource DividerBrush}"
                          BorderThickness="1"
                          Click="ToggleGettingStarted_Click"
                          ToolTipService.ToolTip="Collapse or expand the getting started guide">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="gettingStartedToggleText"
                                 Text="Show guide"
                                 VerticalAlignment="Center" />
                      <FontIcon x:Name="gettingStartedToggleIcon"
                                Glyph="&#xE70D;"
                                FontSize="12"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <StackPanel x:Name="gettingStartedDetails"
                              Grid.Row="1"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Margin="0,8,0,0"
                              Visibility="Collapsed">
                    <TextBlock Text="1. Install content  •  2. Choose a game and press A  •  3. Select Start game"
                               Style="{StaticResource HelpfulTextStyle}"
                               Margin="0,0,0,0" />
                    <TextBlock Text="Extracted folders must contain code, content, and meta. Updates and DLC are linked automatically."
                               Style="{StaticResource HelpfulTextStyle}"
                               FontSize="13"
                               Margin="0,2,0,0" />
                    <TextBlock Text="Open game file: WUD, WUX, ISO, WUA, WUHB, RPX, or ELF. Use Open game folder for extracted titles, NUS title.tmd content, or executables with adjacent RPL files."
                               Style="{StaticResource HelpfulTextStyle}"
                               FontSize="13"
                               Margin="0,2,0,0" />
                    <TextBlock Text="No external drive? GamesToInstall detects WUD, WUX, ISO, WUA, WUHB, RPX, ELF, extracted titles, updates, DLC, and Graphic Packs."
                               Style="{StaticResource HelpfulTextStyle}"
                               FontSize="13"
                               Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,0">
                      <FontIcon Glyph="&#xE8C9;"
                                FontSize="14"
                                Foreground="{StaticResource AccentBlueBrush}"
                                VerticalAlignment="Top"
                                Margin="0,1,7,0" />
                      <TextBlock Text="Some encrypted WUD, WUX, ISO, and WUA games require a valid keys.txt before they can be recognized. Select Import keys.txt first."
                                 Style="{StaticResource HelpfulTextStyle}"
                                 Foreground="{StaticResource AccentBlueHoverBrush}"
                                 FontSize="13" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Installed games"
                             Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="The confirmed game remains selected while you navigate the screen."
                             Style="{StaticResource HelpfulTextStyle}"
                             Margin="0,2,12,0" />
                </StackPanel>

                <CommandBar Grid.Column="1"
                            Background="Transparent"
                            Foreground="White"
                            DefaultLabelPosition="Bottom"
                            IsDynamicOverflowEnabled="True">
                  <AppBarButton x:Name="installContentButton"
                                Label="Install content"
                                Icon="Add"
                                Foreground="White"
                                IsEnabled="False"
                                Click="InstallContent_Click" />
                  <AppBarButton x:Name="importKeysButton"
                                Label="Import keys.txt"
                                Icon="Document"
                                Foreground="White"
                                IsEnabled="False"
                                Click="ImportKeys_Click" />
                  <AppBarButton x:Name="refreshLibraryButton"
                                Label="Scan local folder"
                                Icon="Refresh"
                                Foreground="White"
                                IsEnabled="False"
                                Click="RefreshLibrary_Click" />
                  <AppBarButton x:Name="scanExternalStorageButton"
                                Label="Choose external storage"
                                Icon="Refresh"
                                Foreground="White"
                                IsEnabled="False"
                                Click="ScanExternalStorage_Click" />
                  <AppBarButton x:Name="downloadGraphicPacksButton"
                                Label="Download graphic packs"
                                Icon="Download"
                                Foreground="White"
                                IsEnabled="False"
                                Click="DownloadGraphicPacks_Click" />
                  <AppBarButton x:Name="clearShaderCacheButton"
                                Label="Clear shader cache"
                                Icon="Clear"
                                Foreground="White"
                                IsEnabled="False"
                                Click="ClearShaderCache_Click" />
                </CommandBar>
              </Grid>

              <Border Grid.Row="2"
                      Background="#CC071E17"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="5">
                <ListView x:Name="installedGamesList"
                          Background="Transparent"
                          Foreground="White"
                          ItemContainerStyle="{StaticResource LibraryItemStyle}"
                          SelectionChanged="InstalledGames_SelectionChanged"
                          ItemClick="InstalledGames_ItemClick"
                          IsItemClickEnabled="True"
                          SelectionMode="Single"
                          SingleSelectionFollowsFocus="False"
                          MinHeight="105"
                          MaxHeight="165">
                  <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FF0D6ECA" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FF1689E8" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#55366B58" />
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="White" />
                  </ListView.Resources>
                </ListView>
              </Border>
            </Grid>
          </PivotItem>

          <PivotItem Header="Toy Pad">
            <Grid Padding="24,6,24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel>
                <TextBlock Text="LEGO Dimensions Toy Pad"
                           Style="{StaticResource SectionHeadingStyle}" />
                <TextBlock Text="Choose a character, vehicle, or gadget and place its persistent virtual tag on the native Toy Pad. Game-written upgrades are saved automatically. Press View + Menu during a game to open or close options."
                           Style="{StaticResource HelpfulTextStyle}"
                           Margin="0,3,0,10" />
              </StackPanel>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="dimensionsFigureBox"
                          Header="Figure"
                          PlaceholderText="Choose a figure"
                          IsEnabled="False"
                          Margin="0,0,12,0"
                          HorizontalAlignment="Stretch" />
                <ComboBox x:Name="dimensionsSlotBox"
                          Grid.Column="1"
                          Header="Toy Pad position"
                          SelectedIndex="1"
                          IsEnabled="False"
                          Margin="0,0,12,0"
                          HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="Left: top" />
                  <ComboBoxItem Content="Center" />
                  <ComboBoxItem Content="Right: top" />
                  <ComboBoxItem Content="Left: lower 1" />
                  <ComboBoxItem Content="Left: lower 2" />
                  <ComboBoxItem Content="Right: lower 1" />
                  <ComboBoxItem Content="Right: lower 2" />
                </ComboBox>
                <Button x:Name="placeDimensionsFigureButton"
                        Grid.Column="2"
                        Content="Place or replace"
                        IsEnabled="False"
                        VerticalAlignment="Bottom"
                        Margin="0,0,8,0"
                        Click="PlaceDimensionsFigure_Click" />
                <Button x:Name="removeDimensionsFigureButton"
                        Grid.Column="3"
                        Content="Remove"
                        IsEnabled="False"
                        VerticalAlignment="Bottom"
                        Click="RemoveDimensionsFigure_Click" />
              </Grid>

              <StackPanel Grid.Row="2"
                          Orientation="Horizontal"
                          Margin="0,10,0,0">
                <ComboBox x:Name="dimensionsSourceSlotBox"
                          Header="Move existing tag from"
                          SelectedIndex="1"
                          IsEnabled="False"
                          Width="250"
                          Margin="0,0,8,0">
                  <ComboBoxItem Content="Left: top" />
                  <ComboBoxItem Content="Center" />
                  <ComboBoxItem Content="Right: top" />
                  <ComboBoxItem Content="Left: lower 1" />
                  <ComboBoxItem Content="Left: lower 2" />
                  <ComboBoxItem Content="Right: lower 1" />
                  <ComboBoxItem Content="Right: lower 2" />
                </ComboBox>
                <Button x:Name="moveDimensionsFigureButton"
                        Content="Move to selected position"
                        IsEnabled="False"
                        VerticalAlignment="Bottom"
                        Click="MoveDimensionsFigure_Click" />
              </StackPanel>

              <Border Grid.Row="3"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12,9"
                      Margin="0,12,0,0">
                <TextBlock x:Name="dimensionsStatus"
                           Text="The native Toy Pad will be ready when Cemu finishes initializing."
                           Style="{StaticResource HelpfulTextStyle}" />
              </Border>
            </Grid>
          </PivotItem>

          <PivotItem Header="Settings">
            <Grid Padding="24,6,24,16">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Cemu settings" Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="Direct3D 11 and the Xbox GPU are fixed by this host. Changes marked for restart apply to the next game launch."
                             Style="{StaticResource HelpfulTextStyle}" Margin="0,2,16,8" />
                </StackPanel>
                <Button x:Name="applySettingsButton" Grid.Column="1" Content="Apply settings"
                        IsEnabled="False" Click="ApplySettings_Click" />
              </Grid>
              <ScrollViewer Grid.Row="1"
                            VerticalScrollMode="Enabled"
                            VerticalScrollBarVisibility="Visible"
                            HorizontalScrollMode="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            IsTabStop="True">
                <StackPanel Spacing="10">
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="cpuModeBox" Header="CPU mode" SelectedIndex="4">
                          <ComboBoxItem Content="Single-core interpreter"/><ComboBoxItem Content="Single-core recompiler"/>
                          <ComboBoxItem Content="Dual-core recompiler (legacy)"/><ComboBoxItem Content="Multi-core recompiler"/><ComboBoxItem Content="Auto"/>
                        </ComboBox>
                        <ComboBox x:Name="consoleLanguageBox" Header="Console language" SelectedIndex="1">
                          <ComboBoxItem Content="Japanese"/><ComboBoxItem Content="English"/><ComboBoxItem Content="French"/><ComboBoxItem Content="German"/>
                          <ComboBoxItem Content="Italian"/><ComboBoxItem Content="Spanish"/><ComboBoxItem Content="Chinese"/><ComboBoxItem Content="Korean"/>
                          <ComboBoxItem Content="Dutch"/><ComboBoxItem Content="Portuguese"/><ComboBoxItem Content="Russian"/><ComboBoxItem Content="Taiwanese"/>
                        </ComboBox>
                        <CheckBox x:Name="bootSoundCheck" Content="Play boot sound"/>
                        <CheckBox x:Name="disableScreensaverCheck" Content="Disable screen saver"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Graphics" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Text="Backend: Direct3D 11 (Xbox fixed)" Style="{StaticResource HelpfulTextStyle}"/>
                        <ComboBox x:Name="vsyncBox" Header="VSync" SelectedIndex="1"><ComboBoxItem Content="Off"/><ComboBoxItem Content="On"/></ComboBox>
                        <CheckBox x:Name="asyncCompileCheck" Content="Async shader compile"/>
                        <CheckBox x:Name="gx2SyncCheck" Content="GX2DrawDone synchronization"/>
                        <CheckBox x:Name="upsideDownCheck" Content="Render upside down"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Scaling and gamma" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="upscaleFilterBox" Header="Upscale filter" SelectedIndex="1"><ComboBoxItem Content="Linear"/><ComboBoxItem Content="Bicubic"/><ComboBoxItem Content="Bicubic Hermite"/><ComboBoxItem Content="Nearest neighbor"/></ComboBox>
                        <ComboBox x:Name="downscaleFilterBox" Header="Downscale filter" SelectedIndex="0"><ComboBoxItem Content="Linear"/><ComboBoxItem Content="Bicubic"/><ComboBoxItem Content="Bicubic Hermite"/><ComboBoxItem Content="Nearest neighbor"/></ComboBox>
                        <ComboBox x:Name="scalingBox" Header="Fullscreen scaling" SelectedIndex="0"><ComboBoxItem Content="Keep aspect ratio"/><ComboBoxItem Content="Stretch"/></ComboBox>
                        <CheckBox x:Name="overrideGammaCheck" Content="Override game gamma"/>
                        <Slider x:Name="gammaSlider" Header="Gamma" Minimum="1" Maximum="3" StepFrequency="0.1" Value="2.2"/>
                        <Slider x:Name="displayGammaSlider" Header="Display gamma (0 = sRGB)" Minimum="0" Maximum="3" StepFrequency="0.1" Value="2.2"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="notificationPositionBox" Header="Position" SelectedIndex="1"><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="Top left"/><ComboBoxItem Content="Top center"/><ComboBoxItem Content="Top right"/><ComboBoxItem Content="Bottom left"/><ComboBoxItem Content="Bottom center"/><ComboBoxItem Content="Bottom right"/></ComboBox>
                        <Slider x:Name="notificationScaleSlider" Header="Text scale" Minimum="50" Maximum="300" StepFrequency="10" Value="100"/>
                        <CheckBox x:Name="notifyProfilesCheck" Content="Controller profiles"/><CheckBox x:Name="notifyBatteryCheck" Content="Controller battery"/>
                        <CheckBox x:Name="notifyShadersCheck" Content="Shader compiling"/><CheckBox x:Name="notifyFriendsCheck" Content="Friends"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Audio" Style="{StaticResource SectionHeadingStyle}" />
                        <ComboBox x:Name="audioApiBox" Header="Audio backend" SelectedIndex="0"><ComboBoxItem Content="XAudio 2.8 (recommended)"/><ComboBoxItem Content="DirectSound"/><ComboBoxItem Content="XAudio 2.7"/><ComboBoxItem Content="Cubeb"/></ComboBox>
                        <Slider x:Name="audioDelaySlider" Header="Latency level" Minimum="0" Maximum="10" StepFrequency="1" Value="2"/>
                        <ComboBox x:Name="tvChannelsBox" Header="TV channels" SelectedIndex="1"><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/><ComboBoxItem Content="Surround"/></ComboBox>
                        <ComboBox x:Name="padChannelsBox" Header="GamePad channels" SelectedIndex="1"><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/><ComboBoxItem Content="Surround"/></ComboBox>
                        <ComboBox x:Name="inputChannelsBox" Header="Input channels" SelectedIndex="0"><ComboBoxItem Content="Mono"/><ComboBoxItem Content="Stereo"/><ComboBoxItem Content="Surround"/></ComboBox>
                        <Slider x:Name="tvVolumeSlider" Header="TV volume" Minimum="0" Maximum="100" StepFrequency="1" Value="50"/>
                        <Slider x:Name="padVolumeSlider" Header="GamePad volume" Minimum="0" Maximum="100" StepFrequency="1" Value="0"/>
                        <Slider x:Name="inputVolumeSlider" Header="Input volume" Minimum="0" Maximum="100" StepFrequency="1" Value="50"/>
                        <Slider x:Name="portalVolumeSlider" Header="Portal volume" Minimum="0" Maximum="100" StepFrequency="1" Value="50"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Emulated USB devices" Style="{StaticResource SectionHeadingStyle}" />
                      <StackPanel Orientation="Horizontal" Spacing="20">
                        <CheckBox x:Name="skylandersCheck" Content="Skylanders portal"/>
                        <CheckBox x:Name="infinityCheck" Content="Disney Infinity base"/>
                        <CheckBox x:Name="dimensionsCheck" Content="LEGO Dimensions Toy Pad"/>
                      </StackPanel>
                      <TextBlock Text="USB-device changes require restarting the app before launching a game." Style="{StaticResource HelpfulTextStyle}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="settingsStatus" Text="Settings become available when Cemu is ready." Style="{StaticResource HelpfulTextStyle}" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </PivotItem>

          <PivotItem Header="Help and errors">
            <Grid Padding="24,6,24,22">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Session diagnostics"
                             Style="{StaticResource SectionHeadingStyle}" />
                  <TextBlock Text="If something does not work, check the latest message below. The complete log is stored in the app's local data."
                             Style="{StaticResource HelpfulTextStyle}"
                             Margin="0,3,16,0" />
                </StackPanel>
                <AppBarButton Grid.Column="1"
                              Label="Clear messages"
                              Icon="Delete"
                              Foreground="White"
                              Click="ClearErrors_Click"
                              HorizontalAlignment="Right" />
              </Grid>

              <Border Grid.Row="1"
                      Background="#CC071E17"
                      BorderBrush="{StaticResource DividerBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="8">
                <ListView x:Name="errorsList"
                          Background="Transparent"
                          Margin="0"
                          MinHeight="115"
                          MaxHeight="230">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="4,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FFE57373"
                                CornerRadius="2"
                                Margin="0,1,10,1" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas"
                                   Foreground="#FFFFC7C7" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </Grid>
          </PivotItem>
        </Pivot>
      </Grid>
    </Grid>
  </Grid>
</Page>
