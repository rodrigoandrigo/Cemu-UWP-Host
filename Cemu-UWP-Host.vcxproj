  <ItemGroup>
    <Content Include="$(CemuBuildDir)\$(CemuBinaryName).dll">
      <Link>$(CemuBinaryName).dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Cemu resolves runtime data relative to CemuEmbedConfig::data_path.
         In the UWP host that path is Package::InstalledLocation, therefore
         the resource tree and built-in game profiles must be AppX content.
         Omitting sharedFonts makes OSGetSharedData return placeholder data
         and several titles subsequently dereference an invalid guest object. -->
    <Content Include="$(CemuBuildDir)\resources\**\*">
      <Link>resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(CemuBuildDir)\gameProfiles\**\*">
      <Link>gameProfiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
